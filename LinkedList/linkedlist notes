4. Reverse Linked List Pattern ⭐⭐⭐
Kab Use Hota Hai?
Reverse List
Palindrome List
Reverse Between
Reorder List
Template
ListNode prev = null;

ListNode curr = head;

while(curr != null){

    ListNode next =
            curr.next;

    curr.next = prev;

    prev = curr;

    curr = next;
}

return prev;
