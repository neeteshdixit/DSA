// ======================================================================================
// 7. CYCLIC SORT
// ======================================================================================

/*

MOST IMPORTANT DSA SORT

-------------------------------------------------

CONDITION

Array contains

1 to N

numbers

-------------------------------------------------

THINKING

Har element ko
uski correct position pe rakho.

-------------------------------------------------

EXAMPLE

3 5 2 1 4

↓

1 2 3 4 5

-------------------------------------------------

CORRECT POSITION

1 -> index 0

2 -> index 1

3 -> index 2

4 -> index 3

5 -> index 4

-------------------------------------------------

SYNTAX

int i=0;

while(i<n){

    int correct = arr[i]-1;

    if(arr[i] != arr[correct]){

        swap(i,correct);
    }

    else{

        i++;
    }
}

-------------------------------------------------

KEYWORDS

1 to N

Missing Number

Duplicate Number

First Missing Positive

Disappeared Numbers

-------------------------------------------------

LEETCODE

268

448

287

41

*/


