===============================================================================
BFS TEMPLATE
===============================================================================

Queue<Integer> q =
new LinkedList<>();

q.offer(source);

visited[source] = true;

while(!q.isEmpty()){

    int node =
    q.poll();

    for(int nbr :
        graph[node]){

        if(!visited[nbr]){

            visited[nbr] = true;

            q.offer(nbr);
        }
    }
}

