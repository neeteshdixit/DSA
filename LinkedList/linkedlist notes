7. Merge Two Sorted Lists ⭐
Kab Use Hota Hai?
Merge Lists
Merge K Lists
Sorting
Template
ListNode dummy =
        new ListNode(-1);

ListNode tail = dummy;

while(
    l1 != null &&
    l2 != null
){

    if(l1.val < l2.val){

        tail.next = l1;

        l1 = l1.next;
    }
    else{

        tail.next = l2;

        l2 = l2.next;
    }

    tail = tail.next;
}

if(l1 != null)
    tail.next = l1;

if(l2 != null)
    tail.next = l2;

return dummy.next;
