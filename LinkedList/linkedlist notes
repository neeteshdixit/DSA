10. Find Intersection
Pattern
Two Pointer
Template
ListNode a = headA;

ListNode b = headB;

while(a != b){

    a =
    (a == null)
    ? headB
    : a.next;

    b =
    (b == null)
    ? headA
    : b.next;
}

return a;
