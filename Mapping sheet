PATTERN : VALID BST
===============================================================================

boolean dfs(
 TreeNode root,
 long min,
 long max
){

    if(root == null){

        return true;
    }

    if(
       root.val <= min
       ||
       root.val >= max
    ){

        return false;
    }

    return
    dfs(
      root.left,
      min,
      root.val
    )
    &&
    dfs(
      root.right,
      root.val,
      max
    );
}

TRICK

