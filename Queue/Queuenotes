Queue<TreeNode> q =
new LinkedList<>();

q.offer(root);

while(!q.isEmpty()){

    int size =
    q.size();

    for(int i=0;
        i<size;
        i++){

        TreeNode node =
        q.poll();

        if(node.left != null)
            q.offer(node.left);

        if(node.right != null)
            q.offer(node.right);
    }
}

