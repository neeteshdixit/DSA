===============================================================================
DFS TEMPLATE
===============================================================================

void dfs(
    int node,
    boolean[] visited,
    ArrayList<Integer>[] graph
){

    visited[node] = true;

    for(int nbr :
        graph[node]){

        if(!visited[nbr]){

            dfs(
                nbr,
                visited,
                graph
            );
        }
    }
}

